# MongoDB connection string. Required in production.
# Locally you can leave it empty: the server then starts a temporary in-memory database
# (data is lost on restart).
MONGODB_URI=""

# Optional: database name (default: barraiser)
# MONGODB_DB="barraiser"

# Optional: port (default: 3000)
# PORT=3000

# There is no Gemini key here on purpose. Each user adds their own key in the app
# (Account menu, Gemini key). It is stored only in their browser.
